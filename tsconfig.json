{
  "compilerOptions": {
    "target": "es2017",
    "lib": ["DOM", "ES2017"],
    "module": "esnext",
    "moduleResolution": "node",
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "downlevelIteration": true
  },
  "include": ["src", "type.d.ts"]
}
